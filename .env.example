VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Authentication 탭에서 가족 공용 계정을 하나 만들고(예: family@danjilog.app)
# 그 계정의 이메일을 여기에 적어주세요. 로그인 화면에서는 비밀번호(코드)만 입력받습니다.
VITE_FAMILY_LOGIN_EMAIL=family@danjilog.app

# `npx web-push generate-vapid-keys`로 생성한 키 쌍 중 공개키만 여기 사용 (비밀키는 절대 클라이언트/레포에 넣지 않음 — Supabase secrets로만 관리)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
